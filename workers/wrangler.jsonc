{
	"name": "caddy",
	"main": "worker.js",
	"compatibility_date": "2026-05-01",
	"compatibility_flags": [
    	"nodejs_compat"
  	],
	"assets": {
		"directory": "./assets",
		"binding": "ASSETS"
	},
	"observability": {
		"logs": {
			"enabled": true
		}
	},
	"vars": {
		"CADDYFILE": "{\n\tadmin off\n\tauto_https off\n}\n\n:80 {\n\trespond \"caddy-on-cloudflare\"\n}\n"
	}
}
